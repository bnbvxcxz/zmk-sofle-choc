#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <250>;
    acceleration-exponent = <2>;
    trigger-period-ms = <12>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <20>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Q (13) + S (26) + Z (37) in 60-key Sofle layout */
        softoff {
            bindings = <&soft_off>;
            key-positions = <13 26 37>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "L0";
            bindings = <
&kp ESCAPE        &kp N1            &kp N2             &kp N3        &kp N4        &kp N5                                  &kp N6       &kp N7     &kp N8     &kp N9      &kp N0     &kp BACKSLASH
&kp TAB           &kp Q             &kp W              &kp E         &kp R         &kp T                                   &kp Y        &kp U      &kp I      &kp O       &kp P      &kp BACKSPACE
&kp LEFT_SHIFT    &kp A             &kp S              &kp D         &kp F         &kp G                                   &kp H        &kp J      &kp K      &kp L       &kp SEMI   &kp SQT
&kp LEFT_CONTROL  &kp Z             &kp X              &kp C         &kp V         &kp B      &kp C_PLAY_PAUSE   &none     &kp N        &kp M      &kp COMMA  &kp PERIOD  &kp SLASH  &kp DELETE
                                    &kp LEFT_BRACKET   &kp RIGHT_BRACKET &kp LEFT_ALT &kp LEFT_GUI &kp SPACE     &kp RETURN &mo 1       &kp BACKSPACE &none  &none
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_1 {
            display-name = "L1";
            bindings = <
&kp GRAVE  &kp F1      &kp F2      &kp F3   &kp F4   &kp F5                        &kp F6         &kp F7         &kp F8    &kp F9     &kp F10  &kp F11
&trans     &trans      &trans      &trans   &trans   &trans                        &kp PAGE_UP    &kp PAGE_DOWN  &kp HOME  &kp END    &kp INS  &kp F12
&trans     &trans      &trans      &trans   &trans   &trans                        &kp LEFT       &kp DOWN       &kp UP    &kp RIGHT  &trans   &trans
&trans     &trans      &trans      &trans   &trans   &trans  &tog 2    &mkp LCLK   &kp MINUS      &kp EQUAL      &none     &none      &none    &kp PRINTSCREEN
                       &kp C_BRI_DN &kp C_BRI_UP &trans &trans &trans  &trans      &trans         &trans         &none     &out OUT_USB
            >;
            sensor-bindings = <&scroll_encoder &rsr_trans>;
        };

        layer_2 {
            display-name = "L2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans     &trans  &trans
&trans  &trans  &kp W   &trans  &trans  &trans                  &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &kp A   &kp S   &kp D   &trans  &trans                  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "L3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            display-name = "L4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
